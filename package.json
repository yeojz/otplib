{
  "name": "otplib-repo",
  "version": "12.0.1",
  "private": true,
  "type": "module",
  "description": "TypeScript-first library for TOTP and HOTP with multi-runtime and plugin support",
  "workspaces": [
    "apps/*",
    "internal/*",
    "packages/*"
  ],
  "scripts": {
    "bench:base32": "npm run bench:base32 -w @repo/benchmarks",
    "bench:hotp": "npm run bench:hotp -w @repo/benchmarks",
    "bench:totp": "npm run bench:totp -w @repo/benchmarks",
    "bench:utils": "npm run bench:utils -w @repo/benchmarks",
    "bench": "npm run bench -w @repo/benchmarks",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "docs:api": "turbo run docs:api",
    "docs:build": "turbo run docs:build",
    "docs:dev": "turbo run docs:dev",
    "docs:serve": "turbo run docs:serve",
    "fix": "npm run lint:fix && npm run format",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint:fix": "turbo run lint -- --fix",
    "lint": "turbo run lint",
    "postinstall": "lefthook install",
    "release:packages-dry-run": "npm publish --access public --dry-run -w packages/core -w packages/hotp -w packages/totp -w packages/uri -w packages/plugin-base32-scure -w packages/plugin-base32-alt -w packages/plugin-crypto-noble -w packages/plugin-crypto-node -w packages/plugin-crypto-web -w packages/v11-adapter -w packages/v12-adapter -w packages/otplib",
    "release:packages": "npm publish --access public -w packages/core -w packages/hotp -w packages/totp -w packages/uri -w packages/plugin-base32-scure -w packages/plugin-base32-alt -w packages/plugin-crypto-noble -w packages/plugin-crypto-node -w packages/plugin-crypto-web -w packages/v11-adapter -w packages/v12-adapter -w packages/otplib",
    "size:check": "size-limit --json",
    "size": "size-limit",
    "test:ci": "vitest --run --coverage",
    "test:dist-bun": "bun test internal/distribution-tests/src/bun.test.ts",
    "test:dist-deno": "deno test --allow-read --no-check internal/distribution-tests/src/deno.test.ts",
    "test:dist-node": "vitest run --config internal/distribution-tests/vitest.config.ts",
    "test:docker": "sh scripts/test-docker.sh",
    "test": "vitest --run",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@codecov/bundle-analyzer": "^1.9.1",
    "@eslint/js": "^9.39.2",
    "@size-limit/preset-small-lib": "^12.0.0",
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "fast-check": "^4.5.3",
    "lefthook": "^2.1.1",
    "prettier": "^3.8.1",
    "size-limit": "^12.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.10",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.10.0",
    "typedoc-vitepress-theme": "^1.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vitest-tsconfig-paths": "^3.4.1"
  },
  "overrides": {
    "preact@>=10.28.0 <10.28.2": ">=10.28.2",
    "esbuild@<=0.24.2": ">=0.25.0",
    "undici@<6.23.0": ">=6.23.0",
    "markdown-it@>=13.0.0 <14.1.1": ">=14.1.1"
  },
  "packageManager": "npm@11.0.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  }
}
