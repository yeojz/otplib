{
  "name": "otplib-repo",
  "version": "12.0.1",
  "private": true,
  "type": "module",
  "description": "TypeScript-first library for TOTP and HOTP with multi-runtime and plugin support",
  "scripts": {
    "bench:base32": "pnpm --filter @repo/benchmarks bench:base32",
    "bench:hotp": "pnpm --filter @repo/benchmarks bench:hotp",
    "bench:totp": "pnpm --filter @repo/benchmarks bench:totp",
    "bench:utils": "pnpm --filter @repo/benchmarks bench:utils",
    "bench": "pnpm --filter @repo/benchmarks bench",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "docs:api": "turbo run docs:api",
    "docs:build": "turbo run docs:build",
    "docs:dev": "turbo run docs:dev",
    "docs:serve": "turbo run docs:serve",
    "fix": "pnpm lint:fix && pnpm format",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint:fix": "turbo run lint -- --fix",
    "lint": "turbo run lint",
    "postinstall": "lefthook install",
    "release:packages-dry-run": "pnpm publish -r --filter './packages/*' --access public --provenance --no-git-checks --dry-run",
    "release:packages": "pnpm publish -r --filter './packages/*' --access public --provenance --no-git-checks",
    "size:check": "node ./scripts/check-size.mjs --json",
    "size": "node ./scripts/check-size.mjs",
    "test:ci": "vitest --run --coverage",
    "test:dist-bun": "bun test internal/distribution-tests/src/bun.test.ts",
    "test:dist-deno": "deno test --allow-read --no-check internal/distribution-tests/src/deno.test.ts",
    "test:dist-node": "vitest run --config internal/distribution-tests/vitest.config.ts",
    "test:docker": "sh scripts/test-docker.sh",
    "test:mutation": "stryker run",
    "test": "vitest --run",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@codecov/bundle-analyzer": "^2.0.1",
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "fast-check": "^4.9.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "turbo": "^2.10.7",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-tsconfig-paths": "^3.4.1"
  },
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  }
}
